# ==============================================================================
# HỌC MÓN NGON - BIẾN MÔI TRƯỜNG CẤU HÌNH CHO VERCEL & FIREBASE
# ==============================================================================

# 1. CẤU HÌNH FIREBASE CLIENT-SIDE (Dùng cho giao diện web chạy trên trình duyệt)
# Lấy các thông số này tại: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="hoc-mon-ngon.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="hoc-mon-ngon"
VITE_FIREBASE_STORAGE_BUCKET="hoc-mon-ngon.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# 2. CẤU HÌNH FIREBASE ADMIN SDK (Dành cho Vercel Serverless Function / API Webhook)
# Lấy file Service Account JSON tại: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Copy từng trường tương ứng dán vào biến môi trường trên Vercel Dashboard (Project Settings -> Environment Variables)
FIREBASE_PROJECT_ID="hoc-mon-ngon"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@hoc-mon-ngon.iam.gserviceaccount.com"
# Lưu ý: Với FIREBASE_PRIVATE_KEY trên Vercel, copy nguyên toàn bộ chuỗi bao gồm "-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 3. CẤU HÌNH BẢO MẬT WEBHOOK SEPAY (Xác thực request gửi từ cổng SePay.vn)
# Chuỗi bí mật do bạn tự đặt (hoặc lấy Webhook Token/API Key từ tài khoản SePay của bạn)
SEPAY_WEBHOOK_TOKEN="sepay_wh_token_hmn88"
SEPAY_API_KEY="YOUR_SEPAY_API_KEY"

# 4. GEMINI API KEY (Tùy chọn: dùng cho tính năng trợ lý ảo ẩm thực AI)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 5. DOMAIN WEBSITE CỦA BẠN (Dùng khi chạy trên Vercel)
APP_URL="https://your-domain.vercel.app"
