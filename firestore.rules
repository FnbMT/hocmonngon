rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. KHÓA HỌC (courses):
    // Cho phép đọc công khai và cho phép Admin tạo/sửa/xóa trực tiếp từ giao diện Web
    match /courses/{courseId} {
      allow read, write: if true;
    }
    
    // 2. GIẢNG VIÊN (instructors):
    // Cho phép đọc công khai và Admin quản lý giảng viên từ giao diện Web
    match /instructors/{instructorId} {
      allow read, write: if true;
    }

    // 3. CÀI ĐẶT TRANG CHỦ & THANH TOÁN (settings):
    // Cho phép hiển thị trang chủ và lưu cấu hình từ Admin Dashboard
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 4. HỌC VIÊN (students):
    // Cho phép tạo khi đăng ký học thử hoặc mua khóa học
    match /students/{studentId} {
      allow read, write: if true;
    }

    // 5. ĐƠN ĐĂNG KÝ KHÓA HỌC (enrollments):
    // Cho phép đọc và đồng bộ tiến độ học tập
    match /enrollments/{enrollmentId} {
      allow read, write: if true;
    }

    // 6. GIAO DỊCH SEPAY (transactions):
    // CHẶN HOÀN TOÀN MỌI GHI ĐÈ TỪ CLIENT để chống gian lận số tiền!
    // Chỉ Webhook Serverless Function trên Vercel (dùng Firebase Admin SDK) được ghi dữ liệu
    match /transactions/{txId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
